# Copy to .env (never commit real values). Secrets are read from the environment only.

# Per-customer Entra app registrations (names referenced from customers.json)
EXAMPLE_CLIENT_ID=YOUR_CLIENT_ID
EXAMPLE_CLIENT_SECRET=YOUR_CLIENT_SECRET

# OSINT
VT_API_KEY=YOUR_VIRUSTOTAL_API_KEY
ABUSEIPDB_API_KEY=YOUR_ABUSEIPDB_API_KEY

# Active provider: ollama, openai, or anthropic. Uncomment the one you want to use and comment out the others.
#SOC_TRIAGE_LLM_PROVIDER=ollama
# OR
#SOC_TRIAGE_LLM_PROVIDER=anthropic
# OR
#SOC_TRIAGE_LLM_PROVIDER=openai

# Dell SSH connection and Ollama. If using Ollama, set the SSH host, user, and ports for the remote model. If using OpenAI or Anthropic, these can be left as placeholders and commented out.
SOC_TRIAGE_OLLAMA_SSH_HOST=HOSTNAME
SOC_TRIAGE_OLLAMA_SSH_USER=USERNAME
SOC_TRIAGE_OLLAMA_PORT=PORT
SOC_TRIAGE_OLLAMA_REMOTE_PORT=PORT
SOC_TRIAGE_OLLAMA_MODEL=gemma4:26b

# Agent (server-side triage_alert_full / CLI triage). If using OpenAI, set the API key and model. If using Anthropic, set the API key and model. If using Ollama, these can be left as placeholders and commented out.
# Anthropic
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
SOC_TRIAGE_MODEL=claude-sonnet-5-5
# OpenAI
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
SOC_TRIAGE_MODEL=gpt-4.1-mini

# Optional tuning (defaults shown)
SOC_TRIAGE_CUSTOMERS=customers.json
VT_REQUESTS_PER_MINUTE=4
OSINT_BUDGET=25
ABUSEIPDB_BUDGET=100
ABUSEIPDB_MAX_AGE_DAYS=90
IPV6_GROUP_PREFIX=32
OSINT_CACHE_PATH=.cache/osint.sqlite
OSINT_CACHE_TTL_HOURS=24
LLM_PSEUDONYMISE=true
MAX_EVENT_ROWS=200
SENTINEL_API_VERSION=2024-09-01
